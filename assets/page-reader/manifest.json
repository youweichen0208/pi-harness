{
	"manifest_version": 3,
	"name": "pi Page Reader",
	"version": "1.0.0",
	"key": "",
	"permissions": [
		"activeTab",
		"scripting",
		"nativeMessaging"
	],
	"optional_host_permissions": [
		"https://*/*",
		"http://*/*"
	],
	"background": {
		"service_worker": "reader.js"
	},
	"action": {
		"default_popup": "popup.html"
	}
}
